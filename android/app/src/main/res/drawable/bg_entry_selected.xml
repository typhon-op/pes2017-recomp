<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen menu entry's band: the pause menu's electric blue under the
     text, fading out to the right, with a red rule along its foot (PES 6's main
     menu layout, in the highlight colour the player already knows). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF1B8DFF" android:centerColor="#D91B8DFF" android:endColor="#001B8DFF" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFDC0014" android:endColor="#00DC0014" />
        </shape>
    </item>
</layer-list>
