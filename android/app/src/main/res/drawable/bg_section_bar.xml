<?xml version="1.0" encoding="utf-8"?>
<!-- A settings panel's header bar: the highlight blue, deeper on the left so
     its white label stays crisp, with the wordmark's red down its outer edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/pes_highlight_deep" android:endColor="@color/pes_highlight" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#DC0014" />
        </shape>
    </item>
</layer-list>
