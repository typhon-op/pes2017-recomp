<?xml version="1.0" encoding="utf-8"?>
<!-- A group of related settings under one heading: a card with a hairline
     edge. The card and its edge come from the theme (a white card in Light
     Mode, a navy one in Dark Mode). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/pesCard" />
    <corners android:radius="6dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/pesCardBorder" />
</shape>
