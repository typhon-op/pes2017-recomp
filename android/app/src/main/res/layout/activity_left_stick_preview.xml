<?xml version="1.0" encoding="utf-8"?>
<!-- The Left stick preview: a page of its own, deliberately NOT a ScrollView.
     The stick fills the window and a thumb never scrolls anything, which was
     the whole problem with the embedded preview on the settings page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pesPage"
    android:orientation="vertical">

    <include layout="@layout/view_back_bar" />

    <TextView
        style="@style/SectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/left_stick_preview" />

    <TextView
        android:id="@+id/left_stick_preview_profile"
        style="@style/SettingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <com.pes2017.recomp.LeftStickPreviewView
        android:id="@+id/left_stick_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/left_stick_preview_page_hint" />

    <TextView
        style="@style/SettingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/left_stick_preview_page_hint" />

    <Button
        android:id="@+id/left_stick_preview_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/left_stick_preview_back" />
</LinearLayout>
