<?xml version="1.0" encoding="utf-8"?>
<!-- PATCHES, opened from the main menu under LANGUAGE: the data pack and the
     edit save that sit beside the game, what is installed now, and the copies
     kept before anything was changed. Laid out like the settings screens: the
     back strip, a panel of sections, a help strip at the foot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pesPage">

    <ImageView
        android:id="@+id/hero_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:adjustViewBounds="true"
        android:alpha="0.16"
        android:scaleType="fitEnd"
        android:src="@drawable/launcher_players"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_back_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_status_section" />

                <TextView
                    android:id="@+id/patches_status"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:text="@string/patches_no_folder" />

                <Button
                    android:id="@+id/patches_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/patches_change_folder" />

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_patch_section" />

                <TextView
                    android:id="@+id/patches_patch"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:text="@string/patches_patch_none" />

                <Button
                    android:id="@+id/patches_install"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/patches_install" />

                <Button
                    android:id="@+id/patches_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_restore" />

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_edit_section" />

                <TextView
                    android:id="@+id/patches_edit"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:text="@string/patches_edit_none" />

                <Button
                    android:id="@+id/patches_edit_replace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/patches_edit_replace" />

                <Button
                    android:id="@+id/patches_edit_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_edit_restore" />

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patches_backups_section" />

                <TextView
                    android:id="@+id/patches_backups"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:text="@string/patches_backups_none" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/patches_protection" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
