<?xml version="1.0" encoding="utf-8"?>
<!-- INSTALL PATCH: pick a source, see what was found and what it costs at its
     peak, then watch the install and read the result. Every step is in this
     one scroll; only the current one is visible (PatchImportActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pesPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_back_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_panel_title"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="4dp"
                        android:text="@string/patch_import_heading"
                        android:textColor="@color/pes_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold|italic"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-condensed" />

                    <TextView
                        style="@style/SettingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:text="@string/patch_import_pick_hint" />
                </LinearLayout>

                <!-- 1. source -->
                <LinearLayout
                    android:id="@+id/step_pick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patch_import_source_section" />

                    <LinearLayout style="@style/SettingGroup">

                        <TextView
                            android:id="@+id/import_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_setting_row"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/patch_import_source_none"
                            android:textColor="?attr/pesText"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />

                        <Button
                            android:id="@+id/pick_archive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_archive" />

                        <Button
                            android:id="@+id/pick_folder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_folder" />

                        <Button
                            android:id="@+id/pick_multipart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_multipart" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_multipart_hint" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_instructions" />

                        <!-- The one source that writes inside the game folder: its
                             own screen, below the sources that do not. -->
                        <Button
                            android:id="@+id/pick_game_files"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_game_files" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_game_files_hint"
                            android:textColor="?attr/pesAccentText"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/import_cancel_pick"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/patch_import_cancel" />
                    </LinearLayout>
                </LinearLayout>

                <!-- scanning -->
                <LinearLayout
                    android:id="@+id/step_scanning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="14dp">

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_scanning"
                            android:textColor="?attr/pesInfoText"
                            android:textSize="14sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_scanning_hint" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. summary -->
                <LinearLayout
                    android:id="@+id/step_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SectionHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patch_import_ready" />

                    <LinearLayout style="@style/SettingGroup">

                        <TextView
                            android:id="@+id/summary_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="8dp"
                            android:textColor="?attr/pesText"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/summary_patch"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/summary_skipped"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/summary_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="?attr/pesAccentText"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_setting_row"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_peak_title"
                            android:textColor="?attr/pesMuted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/peak_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="?attr/pesText"
                            android:textSize="22sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/peak_breakdown"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/low_space"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:textColor="?attr/pesAccentText"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        style="@style/SettingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:text="@string/patch_import_backup_note" />

                    <CheckBox
                        android:id="@+id/system_save_check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/patch_import_system_toggle"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/system_save_hint"
                        style="@style/SettingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patch_import_system_hint"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/install_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/patch_import_install" />

                    <Button
                        android:id="@+id/summary_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/patch_import_cancel" />
                </LinearLayout>

                <!-- 3. install progress -->
                <LinearLayout
                    android:id="@+id/step_install"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_installing"
                            android:textColor="?attr/pesInfoText"
                            android:textSize="14sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:accessibilityLiveRegion="polite" />

                        <ProgressBar
                            android:id="@+id/install_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="1000" />

                        <TextView
                            android:id="@+id/install_text"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite" />

                        <Button
                            android:id="@+id/install_stop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_stop" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. result -->
                <LinearLayout
                    android:id="@+id/step_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/result_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_panel_title"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/pes_on_dark"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            android:id="@+id/result_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/pesText"
                            android:textSize="22sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/result_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/pesText"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/result_detail"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp" />

                        <Button
                            android:id="@+id/result_done"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_result_done" />

                        <Button
                            android:id="@+id/result_retry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/patch_import_retry" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_ticker"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/patch_import_help_strip"
            android:textColor="?attr/pesTickerText"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
</FrameLayout>
