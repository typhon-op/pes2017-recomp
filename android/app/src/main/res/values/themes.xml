<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher's screens: a white page, navy type, red controls. -->
    <style name="Theme.PES17" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/pes_page</item>
        <item name="colorPrimary">@color/pes_navy</item>
        <item name="colorPrimaryDark">@color/pes_navy</item>
        <item name="colorAccent">@color/pes_red</item>
        <item name="colorControlActivated">@color/pes_red</item>
        <item name="android:textColorPrimary">@color/pes_text</item>
        <item name="android:textColorSecondary">@color/pes_muted</item>
        <item name="android:textColorHint">@color/pes_muted</item>
        <item name="buttonStyle">@style/PanelButton</item>
        <item name="android:buttonStyle">@style/PanelButton</item>
        <!-- The wrapper's palette (attrs.xml): the original light values. -->
        <item name="pesPage">@color/pes_page</item>
        <item name="pesPanel">@color/pes_panel</item>
        <item name="pesPanelSurface">@color/pes_panel_overlay_light</item>
        <item name="pesCard">@color/pes_row</item>
        <item name="pesCardBorder">@color/pes_line</item>
        <item name="pesDivider">@color/pes_line</item>
        <item name="pesRowTop">@color/pes_row_light_top</item>
        <item name="pesRowBottom">@color/pes_row_light_bottom</item>
        <item name="pesText">@color/pes_text</item>
        <item name="pesMuted">@color/pes_muted</item>
        <item name="pesAccentText">@color/pes_red</item>
        <item name="pesInfoText">@color/pes_blue</item>
        <item name="pesTicker">@color/pes_highlight</item>
        <item name="pesTickerText">@color/pes_on_dark</item>
        <item name="pesScrimStart">@color/launcher_background</item>
    </style>

    <!--
      The same wrapper screens in Dark Mode (WrapperTheme picks it before a
      screen inflates its layout, so it applies to the launcher and every page
      opened from it). It is a dark AppCompat theme on purpose: the alert
      dialogs the wrapper opens then come with dark surfaces, light body copy
      and the accent buttons already in the right colours.

      The accent colours (the blue section bars, the gold cursor and the red
      highlight) are unchanged; the surfaces and the ink move, and both inks are
      set well above 4.5:1 against the surface under them.
    -->
    <style name="Theme.PES17.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/pes_page_dark</item>
        <item name="colorPrimary">@color/pes_highlight_deep</item>
        <item name="colorPrimaryDark">@color/pes_page_dark</item>
        <item name="colorAccent">@color/pes_highlight</item>
        <item name="colorControlActivated">@color/pes_highlight</item>
        <item name="colorControlNormal">@color/pes_muted_dark</item>
        <item name="android:textColorPrimary">@color/pes_text_dark</item>
        <item name="android:textColorSecondary">@color/pes_muted_dark</item>
        <item name="android:textColorHint">@color/pes_muted_dark</item>
        <item name="buttonStyle">@style/PanelButton</item>
        <item name="android:buttonStyle">@style/PanelButton</item>
        <item name="pesPage">@color/pes_page_dark</item>
        <item name="pesPanel">@color/pes_panel_dark</item>
        <item name="pesPanelSurface">@color/pes_panel_overlay_dark</item>
        <item name="pesCard">@color/pes_row_dark</item>
        <item name="pesCardBorder">@color/pes_line_dark</item>
        <item name="pesDivider">@color/pes_line_dark</item>
        <item name="pesRowTop">@color/pes_row_dark_top</item>
        <item name="pesRowBottom">@color/pes_row_dark_bottom</item>
        <item name="pesText">@color/pes_text_dark</item>
        <item name="pesMuted">@color/pes_muted_dark</item>
        <item name="pesAccentText">@color/pes_red_light</item>
        <item name="pesInfoText">@color/pes_blue_light</item>
        <item name="pesTicker">@color/pes_ticker_dark</item>
        <item name="pesTickerText">@color/pes_ticker_text_dark</item>
        <item name="pesScrimStart">@color/pes_page_dark</item>
    </style>

    <!-- The run: black behind the surface, and the dark pad editor over it. -->
    <style name="Theme.PES17.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#0E1A36</item>
        <item name="colorPrimaryDark">#070D1C</item>
        <item name="colorAccent">@color/pes_gold</item>
        <item name="android:textColorPrimary">#EAF1FF</item>
        <item name="android:textColorSecondary">#8FA0C2</item>
    </style>

    <!--
      The in-game menu (PesMenu): a left-hand panel drawn over the pitch, not a
      floating Android card. No window frame, no title, no animation of its own:
      the panel slides itself in and out so the opening reads as part of the
      game rather than a system dialog appearing.
    -->
    <style name="Theme.PES17.Menu" parent="Theme.AppCompat.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!-- A settings panel's header row: a solid bar, as the PES 6 menus' header strips. -->
    <style name="SectionHeading">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_section_bar</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- One setting: a row with a hairline under it, label on the left. -->
    <style name="SettingLabel">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">?attr/pesText</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="SettingHint">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">?attr/pesMuted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingSwitch">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">?attr/pesText</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- The main menu's entries: big italic capitals, left-aligned, as PES 6's. -->
    <style name="MenuEntry">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableStart">@drawable/ic_menu_cursor_space</item>
        <item name="android:textColor">?attr/pesText</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- A long label wraps to a second line instead of being cut at the
             row's end; Arabic labels are longer than their English ones. The
             row grows to whatever the text needs (MenuColumn). -->
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <!-- A card holding one group of settings (Display, Frame rate, ...). -->
    <style name="SettingGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_setting_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="TabEntry">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- BACK: gold italic capitals with an arrow, on the strip's navy. -->
    <style name="BackButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/pes_gold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      The pad editor's own buttons (ControlEditPanel and edit_panel.xml).

      The editor runs under Theme.PES17.Game, which sets no buttonStyle, so its
      buttons used to fall through to AppCompat's stock grey: stock controls
      sitting in the middle of the game's dark strip. These are transparent blue
      instead. The fill is a third opaque, the outline and the light label carry
      the shape, and the pitch behind the strip reads through it.
    -->
    <style name="EditorButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_editor</item>
        <!-- Light ink, because a stock dark label on see-through blue over a
             bright pitch is the one thing that would stop being readable. -->
        <item name="android:textColor">#E8F2FF</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PanelButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_action</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
