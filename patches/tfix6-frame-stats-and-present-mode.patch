--- a/repo/runtime/frame_stats.h
+++ b/repo/runtime/frame_stats.h
@@ -0,0 +1,107 @@
+#pragma once
+// Frame-interval statistics: what the `fstats:` line reports.
+//
+// The rest of the instrumentation counts events -- stutters.h counts frames
+// lost and the blanks a frame was held, pacing_trace.h prints mean/min/max of
+// the presents' spacing. Mean and max cannot tell a smooth 55 FPS from a 60 FPS
+// run with a spike every second, which is the difference the phone reports are
+// about, so this keeps the intervals themselves and answers with percentiles and
+// the 1% low.
+//
+// One window is one line in game.log: 600 presents, about ten seconds at 60.
+// Everything here is arithmetic on doubles; it opens no device and reads no
+// clock, so tests/frame_stats_test.cpp checks it without a phone.
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstring>
+
+namespace frame_stats
+{
+    struct Summary
+    {
+        size_t count = 0;
+        double fps = 0;          // frames a second over the window, from its own intervals
+        double meanMs = 0;
+        double p50Ms = 0, p90Ms = 0, p99Ms = 0;
+        double worstMs = 0;
+        double low1Ms = 0;       // the mean of the slowest 1%: the "1% low"
+        size_t overOneAndAHalf = 0, overTwice = 0;   // frames over 1.5x and 2x the target
+    };
+
+    class Window
+    {
+    public:
+        // Ten seconds at 60, with room for a burst: a window that fills is
+        // halved rather than stopped, so a long stall cannot freeze the count.
+        static constexpr size_t kCapacity = 1024;
+
+        void Add(double ms)
+        {
+            if (!std::isfinite(ms) || ms < 0) return;
+            if (count_ == kCapacity)
+            {
+                const size_t keep = kCapacity / 2;
+                std::memmove(samples_, samples_ + (kCapacity - keep), keep * sizeof(double));
+                count_ = keep;
+            }
+            samples_[count_++] = ms;
+        }
+
+        void Reset() { count_ = 0; }
+
+        size_t Count() const { return count_; }
+
+        // The window's numbers. `targetMs` is the frame period the run is paced
+        // to (16.667 at 60, 1000/45 at 45); 0 leaves the spike counts at zero.
+        // Does not reset: the caller decides when a window ends.
+        Summary Take(double targetMs) const
+        {
+            Summary s;
+            if (!count_) return s;
+            std::copy(samples_, samples_ + count_, sorted_);
+            std::sort(sorted_, sorted_ + count_);
+
+            double sum = 0;
+            for (size_t i = 0; i < count_; ++i) sum += sorted_[i];
+            s.count = count_;
+            s.meanMs = sum / double(count_);
+            s.fps = sum > 0 ? double(count_) * 1000.0 / sum : 0.0;
+            s.p50Ms = Percentile(50.0);
+            s.p90Ms = Percentile(90.0);
+            s.p99Ms = Percentile(99.0);
+            s.worstMs = sorted_[count_ - 1];
+
+            const size_t slowest = std::max<size_t>(1, size_t(std::lround(double(count_) / 100.0)));
+            double tail = 0;
+            for (size_t i = count_ - slowest; i < count_; ++i) tail += sorted_[i];
+            s.low1Ms = tail / double(slowest);
+
+            if (targetMs > 0)
+                for (size_t i = 0; i < count_; ++i)
+                {
+                    if (sorted_[i] > targetMs * 1.5) s.overOneAndAHalf++;
+                    if (sorted_[i] > targetMs * 2.0) s.overTwice++;
+                }
+            return s;
+        }
+
+    private:
+        // Linear interpolation between the two samples either side, as numpy's
+        // default does: for a smooth run every percentile is the period itself.
+        double Percentile(double p) const
+        {
+            if (!count_) return 0;
+            if (count_ == 1) return sorted_[0];
+            const double x = (p / 100.0) * double(count_ - 1);
+            const size_t lo = size_t(std::floor(x));
+            const double frac = x - double(lo);
+            const size_t hi = std::min(lo + 1, count_ - 1);
+            return sorted_[lo] * (1.0 - frac) + sorted_[hi] * frac;
+        }
+
+        double samples_[kCapacity]{};
+        double mutable sorted_[kCapacity]{};
+        size_t count_ = 0;
+    };
+}
--- a/repo/tests/frame_stats_test.cpp
+++ b/repo/tests/frame_stats_test.cpp
@@ -0,0 +1,144 @@
+// The frame-interval statistics behind the `fstats:` line (runtime/frame_stats.h).
+// It is arithmetic over intervals and nothing else, so the numbers a phone
+// report is judged by are checked here: a smooth run has every percentile at
+// its own period, one slow frame in a hundred is the 1% low and not the mean,
+// the spike counts use the run's own target, and a stall that is really a load
+// screen does not poison the window it follows.
+#include "frame_stats.h"
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+namespace
+{
+    int g_checks = 0;
+    int g_failures = 0;
+
+    void Check(bool ok, const std::string& what)
+    {
+        g_checks++;
+        if (!ok)
+        {
+            g_failures++;
+            std::printf("FAIL: %s\n", what.c_str());
+        }
+    }
+
+    bool Near(double a, double b, double tolerance = 0.01)
+    {
+        return std::fabs(a - b) <= tolerance;
+    }
+
+    void Empty()
+    {
+        frame_stats::Window w;
+        const frame_stats::Summary s = w.Take(16.667);
+        Check(s.count == 0, "an empty window has no frames");
+        Check(s.fps == 0 && s.p50Ms == 0 && s.low1Ms == 0 && s.worstMs == 0, "an empty window is all zeros");
+        Check(s.overOneAndAHalf == 0 && s.overTwice == 0, "an empty window has no spikes");
+    }
+
+    void Smooth()
+    {
+        frame_stats::Window w;
+        for (int i = 0; i < 600; i++) w.Add(1000.0 / 60.0);
+        const frame_stats::Summary s = w.Take(1000.0 / 60.0);
+        Check(s.count == 600, "600 frames counted");
+        Check(Near(s.fps, 60.0, 0.05), "a steady 16.667 ms is 60 fps");
+        Check(Near(s.p50Ms, 16.667) && Near(s.p90Ms, 16.667) && Near(s.p99Ms, 16.667),
+              "every percentile of a smooth run is the period");
+        Check(Near(s.low1Ms, 16.667) && Near(s.worstMs, 16.667), "the 1% low and the worst are the period too");
+        Check(s.overOneAndAHalf == 0 && s.overTwice == 0, "a smooth run has no spikes");
+    }
+
+    void Percentiles()
+    {
+        frame_stats::Window w;
+        for (double ms : { 10.0, 20.0, 30.0, 40.0 }) w.Add(ms);
+        const frame_stats::Summary s = w.Take(0);
+        Check(Near(s.p50Ms, 25.0), "p50 of 10/20/30/40 is 25");
+        Check(Near(s.p90Ms, 37.0), "p90 of 10/20/30/40 is 37");
+        Check(Near(s.p99Ms, 39.7), "p99 of 10/20/30/40 is 39.7");
+        Check(Near(s.worstMs, 40.0), "the worst is the slowest frame");
+        // Four samples: the slowest 1% is one of them.
+        Check(Near(s.low1Ms, 40.0), "the 1% low of four frames is the slowest");
+        Check(Near(s.meanMs, 25.0) && Near(s.fps, 40.0), "mean and fps over the four");
+    }
+
+    // The case the phone reports are about: a run whose mean looks fine and
+    // whose tail does not.
+    void OneInAHundred()
+    {
+        frame_stats::Window w;
+        for (int i = 0; i < 198; i++) w.Add(1000.0 / 60.0);
+        w.Add(100.0);
+        w.Add(100.0);
+        const frame_stats::Summary s = w.Take(1000.0 / 60.0);
+        Check(Near(s.low1Ms, 100.0, 0.001), "the 1% low is the two slow frames, not the mean");
+        Check(s.worstMs > 99.0, "the worst frame is one of them");
+        Check(s.meanMs < 18.0, "and the mean still looks healthy");
+        Check(s.overOneAndAHalf == 2 && s.overTwice == 2, "two frames over 1.5x, both also over 2x");
+    }
+
+    void Spikes()
+    {
+        frame_stats::Window w;
+        for (double ms : { 16.0, 16.0, 20.0, 34.0, 40.0 }) w.Add(ms);
+        const frame_stats::Summary s = w.Take(1000.0 / 60.0);
+        Check(s.overOneAndAHalf == 2, "34 and 40 ms are over 1.5x of 16.667 (20 ms is not)");
+        Check(s.overTwice == 2, "34 and 40 ms are also over 2x");
+        const frame_stats::Summary none = w.Take(0);
+        Check(none.overOneAndAHalf == 0 && none.overTwice == 0, "no target, no spike counts");
+    }
+
+    void NotAFrame()
+    {
+        frame_stats::Window w;
+        w.Add(std::nan(""));
+        w.Add(INFINITY);
+        w.Add(-16.0);
+        Check(w.Count() == 0, "NaN, infinity and a negative interval are not frames");
+        w.Add(16.0);
+        Check(w.Count() == 1, "a real frame still counts");
+    }
+
+    void Rolling()
+    {
+        frame_stats::Window w;
+        for (size_t i = 0; i < frame_stats::Window::kCapacity; i++) w.Add(10.0);
+        w.Add(20.0);
+        // A full window keeps its newer half rather than stopping or growing:
+        // the count lands just under halfway, then fills again.
+        Check(w.Count() == frame_stats::Window::kCapacity / 2 + 1, "a full window halves rather than stopping");
+        const frame_stats::Summary s = w.Take(0);
+        Check(Near(s.worstMs, 20.0, 0.001), "the frame just added is in the window");
+        Check(s.meanMs > 10.0, "the shifted window kept the older frames");
+        w.Reset();
+        Check(w.Count() == 0, "Reset empties it");
+    }
+
+    void Single()
+    {
+        frame_stats::Window w;
+        w.Add(40.0);
+        const frame_stats::Summary s = w.Take(16.667);
+        Check(s.count == 1 && Near(s.p50Ms, 40.0) && Near(s.p99Ms, 40.0) && Near(s.low1Ms, 40.0),
+              "one frame is every percentile");
+        Check(s.overOneAndAHalf == 1 && s.overTwice == 1, "and it is a spike, over both thresholds");
+    }
+}
+
+int main()
+{
+    Empty();
+    Smooth();
+    Percentiles();
+    OneInAHundred();
+    Spikes();
+    NotAFrame();
+    Rolling();
+    Single();
+    std::printf("frame_stats: %d checks, %d failures\n", g_checks, g_failures);
+    return g_failures ? 1 : 0;
+}
